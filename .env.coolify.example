SECRET_KEY=change-me-generate-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=takip.example.com
CSRF_TRUSTED_ORIGINS=https://takip.example.com
# Coolify/Traefik HTTPS yönlendirmesini dış proxy'de yapar.
# Django içinde True yapılırsa container healthcheck HTTP isteği bozulabilir.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

DIA_SERVER_CODE=diademo
DIA_USERNAME=ws
DIA_PASSWORD=ws
DIA_FIRMA_KODU=1
DIA_DONEM_KODU=1
DIA_LOG_API_REQUESTS=True
DIA_SYNC_INTERVAL_MINUTES=1
DIA_CARI_SYNC_INTERVAL_MINUTES=1
DIA_STOK_SYNC_INTERVAL_MINUTES=1
DIA_FATURA_SYNC_INTERVAL_MINUTES=1
DIA_STOK_MIKTAR_SYNC_INTERVAL_MINUTES=1
RUN_CELERY_IN_WEB=True

CREATE_SUPERUSER=True
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-first-deploy

CELERY_RESULT_BACKEND=django-db
