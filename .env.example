#############################################
# Ortam değişkenleri şablonu (bu dosyayı commit edebilirsiniz)
# Gerçek değerleri .env dosyasına koyun, asla commit etmeyin!
#############################################

# Django
SECRET_KEY=guclu-ve-benzersiz-bir-secret-key-girin
DEBUG=False

# Hostlar (virgülle ayrılmış)
# ALLOWED_HOSTS=localhost,127.0.0.1,siteniz.com
# CSRF_TRUSTED_ORIGINS=https://siteniz.com

# ─── MySQL (PythonAnywhere production) ────────────────────────────────────────────
DB_NAME=kullanici$default
DB_USER=kullanici
DB_PASSWORD=mysql-sifreniz
DB_HOST=kullanici.mysql.pythonanywhere-services.com

# ─── Celery / Redis ────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0

# ─── DİA ERP Bağlantı ─────────────────────────────────────────────────────────────
DIA_SERVER_CODE=SUNUCU_KODUNUZ
DIA_USERNAME=dia_kullanici_adiniz
DIA_PASSWORD=dia_sifreniz
DIA_FIRMA_KODU=1
DIA_DONEM_KODU=1
DIA_SESSION_TTL_SECONDS=3000
DIA_LOG_API_REQUESTS=True

# ─── Email ────────────────────────────────────────────────────────────────────────
EMAIL_HOST=mail.meslas.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=info@meslas.com
EMAIL_HOST_PASSWORD=email-sifreniz

# ─── Groq (AI) ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=groq-api-anahtariniz
GROQ_MODEL=llama-3.1-8b-instant
